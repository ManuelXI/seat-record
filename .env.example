# Optional. Without a key, scripted demo entries show illustrative responses and anything else gets a labelled plain draft.
ANTHROPIC_API_KEY=
# Leave unset for the demo. Overrides the committed demo signing key (PKCS#8 PEM, Ed25519), but the public key in
# src/lib/demo-key.ts is fixed, so setting this alone makes every signature fail verification.
SIGNING_PRIVATE_KEY_PEM=
